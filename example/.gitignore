# ──────────────────────────────────────────────
# expo-lottie-splash-screen / example .gitignore
# ──────────────────────────────────────────────

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native folders — generated by `expo prebuild`, do NOT commit.
# To regenerate: npx expo prebuild --platform android --clean
android/
ios/

# Metro bundler cache
.metro-health-check*

# Debug & lock files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store

# Editor
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment
.env
.env.local
.env.*.local
